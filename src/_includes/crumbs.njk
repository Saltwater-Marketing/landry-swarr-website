{% if breadcrumbs and page.url != "/" %}
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {% for b in breadcrumbs %}
    <li>{% if loop.last %}<span aria-current="page">{{ b[0] }}</span>{% else %}<a href="{{ b[1] }}">{{ b[0] }}</a>{% endif %}</li>
    {% endfor %}
  </ol>
</nav>
{% endif %}
