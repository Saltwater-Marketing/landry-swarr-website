<section class="grw" aria-labelledby="grw-h">
  <h2 id="grw-h" class="grw-title">Google reviews</h2>
  <div id="grw-root">
    <div class="grw-loading"><div class="grw-spinner"></div>Loading reviews…</div>
  </div>
</section>
<script>
(function () {
  var WORKER_URL = "https://google-reviews.tech-740.workers.dev";
  var CLIENT_SLUG = "{{ site.reviews.slug }}";
  var INTERVAL_MS = 6000, PER_PAGE = 4;
  var COLORS = [["rgba(53,75,133,.12)","#354b85"],["rgba(172,52,15,.12)","#ac340f"],["rgba(42,122,138,.12)","#2a7a8a"],["rgba(212,148,10,.14)","#9a6b00"]];
  var root = document.getElementById("grw-root"), widget = root.parentElement;
  var cur = 0, total = 0, timer = null, pages = [], built = {}, visible = false;
  function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
  var STAR = '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>';
  function stars(n, cls){var h="";for(var i=1;i<=5;i++){h+='<svg class="'+cls+(i<=n?'':' grw-off')+'" viewBox="0 0 24 24" aria-hidden="true">'+STAR+'</svg>';}return h;}
  function headerStars(r){var pct=Math.max(0,Math.min(100,r/5*100));return '<span class="grw-hstars" role="img" aria-label="'+r.toFixed(1)+' out of 5 stars"><span class="grw-hstars-bg">'+stars(0,"grw-star")+'</span><span class="grw-hstars-fg" style="width:'+pct+'%">'+stars(5,"grw-star")+'</span></span>';}
  function card(r, i){
    var c = COLORS[i % COLORS.length];
    var init = r.author.trim().split(/\s+/).map(function(w){return w[0];}).join("").slice(0,2).toUpperCase();
    var av = r.avatar ? '<img class="grw-avatar--img" src="'+esc(r.avatar)+'" alt="" loading="lazy" decoding="async" width="40" height="40" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'"><div class="grw-avatar" style="display:none;background:'+c[0]+';color:'+c[1]+'">'+esc(init)+'</div>'
                       : '<div class="grw-avatar" style="background:'+c[0]+';color:'+c[1]+'">'+esc(init)+'</div>';
    var n = Math.round(Number(r.rating) || 0);
    return '<div class="grw-card"><div class="grw-card-top">'+av+'<div><div class="grw-name">'+esc(r.author)+'</div><div class="grw-meta"><span class="grw-cs" role="img" aria-label="'+n+' out of 5 stars">'+stars(n,"grw-cstar")+'</span><span class="grw-date">'+esc(r.relativeDate||"")+'</span></div></div></div>'+(r.text?'<p class="grw-text">'+esc(String(r.text).replace(/<br\s*\/?>/gi,' ').replace(/\s+/g,' ').trim())+'</p>':'')+'</div>';
  }
  function build(pi){ if (built[pi]) return; var el = root.querySelector('.grw-page[data-page="'+pi+'"]'); if (el) el.innerHTML = pages[pi].map(function(r,ri){return card(r, pi*PER_PAGE+ri);}).join(""); built[pi]=true; }
  function goTo(i){ var t=(i+total)%total; if(t===cur) return; build(t); var p=root.querySelectorAll(".grw-page"), d=root.querySelectorAll(".grw-dot"); p[cur].classList.remove("visible"); if(d[cur]) d[cur].classList.remove("active"); cur=t; p[cur].classList.add("visible"); if(d[cur]) d[cur].classList.add("active"); }
  function progress(){ var b=document.getElementById("grw-bar"); if(!b) return; b.style.transition="none"; b.style.width="0%"; b.offsetWidth; b.style.transition="width "+INTERVAL_MS+"ms linear"; b.style.width="100%"; }
  function start(){ clearInterval(timer); if (total < 2 || matchMedia("(prefers-reduced-motion: reduce)").matches) return; timer=setInterval(function(){goTo(cur+1);progress();},INTERVAL_MS); progress(); }
  function render(data){
    var rv = (data.reviews || []).map(function(r,i){r._i=i;return r;}).sort(function(a,b){return (Number(b.rating)-Number(a.rating)) || ((b.text?1:0)-(a.text?1:0)) || (a._i-b._i);}); pages=[]; for (var i=0;i<rv.length;i+=PER_PAGE) pages.push(rv.slice(i,i+PER_PAGE)); total=pages.length; built={0:true};
    var ph = pages.map(function(g,pi){return '<div class="grw-page'+(pi===0?' visible':'')+'" data-page="'+pi+'">'+(pi===0?g.map(card).join(""):"")+'</div>';}).join("");
    var dots = pages.map(function(_,i){return '<button type="button" class="grw-dot'+(i===0?' active':'')+'" data-page="'+i+'" aria-label="Show reviews page '+(i+1)+'"></button>';}).join("");
    var arrows = total>1 ? '<button type="button" class="grw-arrow grw-arrow--left" id="grw-prev" aria-label="Previous reviews"><svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg></button><button type="button" class="grw-arrow grw-arrow--right" id="grw-next" aria-label="Next reviews"><svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg></button>' : "";
    root.innerHTML = '<header class="grw-header"><div class="grw-header-left"><div class="grw-glogo" aria-label="Google"><span class="gb">G</span><span class="gr">o</span><span class="gy">o</span><span class="gb">g</span><span class="gg">l</span><span class="gr">e</span></div><div><div class="grw-biz">'+esc(data.businessName)+'</div><div class="grw-summary"><span class="grw-score">'+Number(data.rating).toFixed(1)+'</span>'+headerStars(Number(data.rating))+'<span class="grw-count">'+Number(data.totalReviews).toLocaleString()+' reviews</span></div></div></div><a class="grw-cta" href="'+esc(data.googleMapsUrl)+'" target="_blank" rel="noopener noreferrer">See all reviews on Google &#8599;</a></header>'
      + '<div class="grw-stage-wrap">'+arrows+'<div class="grw-stage">'+ph+'</div></div><div class="grw-progress-wrap"><div class="grw-progress" id="grw-bar"></div></div>'+(total>1?'<div class="grw-dots">'+dots+'</div>':'');
    root.querySelectorAll(".grw-dot").forEach(function(d){d.addEventListener("click",function(){goTo(parseInt(d.dataset.page,10));start();});});
    var pv=document.getElementById("grw-prev"), nx=document.getElementById("grw-next");
    if (pv) pv.addEventListener("click",function(){goTo(cur-1);start();});
    if (nx) nx.addEventListener("click",function(){goTo(cur+1);start();});
    if (visible) start();
  }
  function load(){ fetch(WORKER_URL+"/reviews/"+CLIENT_SLUG).then(function(r){ if(!r.ok) throw new Error(r.status); return r.json(); }).then(function(d){ if(d.error) throw new Error(d.error); render(d); }).catch(function(){ widget.style.display="none"; }); }
  if ("IntersectionObserver" in window) {
    var loaded = false;
    new IntersectionObserver(function(e){ visible = e[0].isIntersecting; if (visible && !loaded) { loaded = true; load(); } if (visible) start(); else clearInterval(timer); }, { rootMargin: "300px 0px", threshold: 0 }).observe(widget);
  } else { visible = true; load(); }
})();
</script>
