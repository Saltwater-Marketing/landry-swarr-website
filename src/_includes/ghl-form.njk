<div class="ghl-form">
  <iframe
    src="https://api.leadconnectorhq.com/widget/form/{{ site.ghl.formId }}"
    style="width:100%;height:{{ site.ghl.formHeight }}px;border:none;border-radius:4px"
    id="inline-{{ site.ghl.formId }}{{ formSuffix or '' }}"
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow" data-trigger-value=""
    data-activation-type="alwaysActivated" data-activation-value=""
    data-deactivation-type="neverDeactivate" data-deactivation-value=""
    data-form-name="{{ site.ghl.formName }}"
    data-height="{{ site.ghl.formHeight }}"
    data-layout-iframe-id="inline-{{ site.ghl.formId }}{{ formSuffix or '' }}"
    data-form-id="{{ site.ghl.formId }}"
    title="{{ site.ghl.formName }}" loading="lazy"></iframe>
  <script src="https://link.msgsndr.com/js/form_embed.js" defer></script>
</div>
